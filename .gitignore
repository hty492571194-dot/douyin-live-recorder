config.prev.json
config.json.bak-*
config.prev.json.bak-*
*.bak-*
hotspots.json
hotspot_events.json

# ---------- ③ 媒体与录制品（体积巨大，且含主播内容） ----------
recordings/
recordings_backup_*/
previews/
spool/
*.flv
*.ass
*.mp4
*.m4s
*.ts

# ---------- ④ 日志 ----------
logs/
*.log
launchd.*.log

# ---------- ⑤ 环境与缓存 ----------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.DS_Store
.vscode/
.idea/
