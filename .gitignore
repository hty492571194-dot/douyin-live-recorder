design_drafts/

# ---------- ③ 媒体与录制品（体积巨大，且含主播内容） ----------
recordings/
recordings_backup_*/
previews/
previews-live/
spool/
*.flv
*.ass
*.mp4
*.m4s
*.ts

# ---------- ④ 日志 ----------
logs/
*.log
launchd.*.log

# 运行态瞬时数据(2026-10-22 硬编改造):画质档位状态 + ffmpeg -progress 文件。
# 含本机负载历史,且属于「跑出来的东西」,不入库。
state/

# ---------- ⑤ 环境与缓存 ----------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.DS_Store
.vscode/
.idea/

# ---------- ⑥ 智能体宿主数据(WorkBuddy automation 记忆等,绝不进仓库) ----------
.workbuddy/
